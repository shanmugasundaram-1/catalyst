# AyuCare - Elderly Care & Medication Management Platform
# PromptWars x Catalyst (Google Build with AI Hackathon)

APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

SECRET_KEY=ayucare_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./ayucare.db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Configuration (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME="AyuCare Care Alert"
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_MOCK=true  # Set to false to send real emails; when true, captures in Live Email Drawer for demo

FRONTEND_URL=http://localhost:5173
