# AyuCare - Elderly Care & Medication Management Platform

# Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & JWT (change SECRET_KEY before production!)
SECRET_KEY=CHANGE_ME_before_production_use_a_32char_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MySQL recommended; SQLite fallback also supported)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/ayucare?charset=utf8mb4
# SQLite fallback: sqlite:///./ayucare.db

# Google Gemini API  — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP (Gmail App Password recommended)
# When SMTP_MOCK=true, emails are logged to the Live Email Inspector — no SMTP config needed!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME="AyuCare Care Alert"
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_MOCK=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
